<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- "Instant": an amber bolt running behind the wrench. -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M63,24 L38,59 L51,59 L45,84 L70,47 L57,47 Z" />
    <!-- Double open-end wrench, drawn level and turned 45°. Its stroke is the background
         gradient, so it cuts a clean gap where it crosses the bolt; the gradient's ends are
         the background's (18,18)→(90,90) taken into this rotated frame. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:fillColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:pathData="M43.037,49.5 H64.963 A11,11 0 0 1 85.341,50.25 H74 A3.75,3.75 0 0 0 74,57.75 H85.341 A11,11 0 0 1 64.963,58.5 H43.037 A11,11 0 0 1 22.659,57.75 H34 A3.75,3.75 0 0 0 34,50.25 H22.659 A11,11 0 0 1 43.037,49.5 Z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="3.1"
                    android:startY="54"
                    android:endX="104.9"
                    android:endY="54"
                    android:startColor="#2E6FD0"
                    android:endColor="#12386F" />
            </aapt:attr>
        </path>
    </group>
</vector>
