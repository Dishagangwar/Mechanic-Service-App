<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MechanicServiceApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorOutline">@color/divider_light</item>

        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand_primary</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#D6E2F5</item>
        <item name="navigationIconTint">#FFFFFF</item>
    </style>

    <!-- Auth screens -->

    <style name="Widget.App.Toolbar.Transparent" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="navigationIconTint">@color/auth_header_title</item>
    </style>

    <!-- Material 3 composites colorSurfaceTint (= colorPrimary) over any elevated surface
         whose fill matches colorSurface, which turned this white card a blue-grey darker
         than the page behind it. The overlay is switched off for this card alone rather
         than app-wide, so the rest of the app's elevated surfaces are untouched. -->
    <style name="ThemeOverlay.App.AuthCard" parent="">
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Widget.App.AuthCard" parent="Widget.Material3.CardView.Elevated">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.AuthCard</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/auth_card_bg</item>
    </style>

    <style name="Widget.App.AuthField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.App.AuthTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/auth_header_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.AuthSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/auth_header_subtitle</item>
    </style>

    <style name="TextAppearance.App.SectionHeader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
